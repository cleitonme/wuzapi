# .env
# Server Configuration
WUZAPI_PORT=8080
WUZAPI_ADDRESS=0.0.0.0

# Token for WuzAPI Admin
WUZAPI_ADMIN_TOKEN=1234ABCD

# Global webhook URL
WUZAPI_GLOBAL_WEBHOOK=https://example.com/webhook

# "json" or "form" for the default
WEBHOOK_FORMAT=json

# WuzAPI Session Configuration
SESSION_DEVICE_NAME=WuzAPI

# Logging configuration
LOG_LEVEL=info  # debug, info, warn, error

# Database configuration
DB_USER=wuzapi
DB_PASSWORD=wuzapi
DB_NAME=wuzapi
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=false
TZ=America/Sao_Paulo

# RabbitMQ configuration Optional
RABBITMQ_URL=amqp://wuzapi:wuzapi@localhost:5672/%2F
RABBITMQ_QUEUE=whatsapp_events
# Max seconds for a single RabbitMQ publish (declare + publish). Default 8.
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=8
# DLQ spool dir: failed-webhook payloads are preserved here as JSON files
# when RabbitMQ is down (no DB migration needed). Default dbdata/webhook_errors.
WEBHOOK_ERROR_SPOOL_DIR=dbdata/webhook_errors
WEBHOOK_ERROR_QUEUE_NAME=webhook_errors
# Max seconds to wait for in-flight webhook/Rabbit deliveries on shutdown. Default 30.
SHUTDOWN_TIMEOUT_SECONDS=30
